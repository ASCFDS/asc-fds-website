{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "asc-fds-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-23",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "node scripts/build-assets.js"
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/spende",
      "/spende/"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
